# --- Database (required for admin, forms, uploads) ---
# Any PostgreSQL connection string (Render free Postgres, Neon, Supabase DB, local).
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Admin login (required to use /admin) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-random-password
# 16+ random characters, used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string

# --- Public site URL (canonical links, sitemap) ---
SITE_URL=http://localhost:3000

# --- Email notifications (optional; inquiries are saved even without these) ---
RESEND_API_KEY=
MAIL_FROM="Rushikesh Nargale <notifications@your-verified-domain.com>"

# --- Website chat assistant (optional) ---
# The assistant works without any key (answers come from the site content).
# Add a free Google Gemini API key for more natural answers. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
